# Copy to terraform.tfvars. Do not commit actual credentials or OCIDs.
tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd:ee:ff"
private_key_path = "/absolute/path/to/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..example"

cluster_name       = "oke-monitoring-lab"
# Verified in us-ashburn-1 on 2026-09-15; confirm before every new deployment.
kubernetes_version = "v1.36.1"
node_shape          = "VM.Standard.E4.Flex"
node_ocpus          = 1
node_memory_gb      = 16
node_count           = 2
